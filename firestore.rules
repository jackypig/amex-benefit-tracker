rules_version = '2';

// Amex Benefit Tracker — single-user lockdown.
//
// Replace PASTE_YOUR_UID_HERE with your own Firebase Auth UID, then deploy:
//   Firebase console > Firestore Database > Rules > paste > Publish
//
// Find your UID under Authentication > Users after signing in once, or run
// `console.log(firebase.auth().currentUser.uid)` in the browser console.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.uid == 'PASTE_YOUR_UID_HERE';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
