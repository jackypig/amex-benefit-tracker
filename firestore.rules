rules_version = '2';

// Amex Benefit Tracker — single-user lockdown.
//
// This file is the actual access control for the tracker. Until it is
// published in the Firebase console it does nothing -- the copy in the repo is
// inert. Google enforces the deployed copy on every read and write.
//
// The UID below must stay identical to ALLOWED_UID in firebase-config.js.
// Deploy this file via:
//   Firebase console > Firestore Database > Rules > paste > Publish

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.uid == '8npYmYebGoVvkogINsvq5b9YM0z2';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
