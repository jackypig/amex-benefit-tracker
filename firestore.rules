rules_version = '2';

// Amex Benefit Tracker — single-user lockdown.
//
// This file is the actual access control for the tracker. Until it is
// published in the Firebase console it does nothing -- the copy in the repo is
// inert. Google enforces the deployed copy on every read and write.
//
// Replace PASTE_YOUR_UID_HERE with your own Firebase Auth UID (the same value
// as ALLOWED_UID in firebase-config.js), then deploy:
//   Firebase console > Firestore Database > Rules > paste > Publish
//
// Run the site once in setup mode to have it show you your UID, or read it
// from Authentication > Users.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.uid == 'PASTE_YOUR_UID_HERE';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
